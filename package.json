{
  "name": "seas-ai-desktop",
  "productName": "Seas AI",
  "version": "3.1.25",
  "description": "Seas AI — desktop personal assistant shell (Electron wrapper)",
  "author": "Seas AI",
  "main": "main.js",
  "desktopName": "com.seas.ai.desktop",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "web:build": "node scripts/web-build.mjs",
    "web:zip": "npm run web:build && node scripts/cloudflare-zip.mjs",
    "web:preview": "python3 -m http.server 3002 --directory dist-web --bind 0.0.0.0",
    "web:deploy": "wrangler pages deploy dist-web --project-name seas-ai-agent"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.seas.ai",
    "productName": "Seas AI",
    "copyright": "Copyright © 2026 Seas AI",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "main.js",
      "pc.js",
      "preload.js",
      "cloud.json",
      "manifest.webmanifest",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "Seas-AI-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Seas AI",
      "runAfterFinish": true,
      "uninstallDisplayName": "Seas AI ${version}"
    },
    "linux": {
      "target": [{ "target": "AppImage", "arch": ["x64"] }],
      "syncDesktopName": true,
      "category": "Utility",
      "synopsis": "Sci-fi AI desktop assistant",
      "description": "Seas AI — voice-driven sci-fi desktop assistant shell.",
      "desktop": {
        "entry": {
          "Name": "Seas AI",
          "Comment": "Sci-fi AI desktop assistant",
          "Categories": "Utility;"
        }
      },
      "artifactName": "Seas-AI-${version}-${arch}.${ext}"
    }
  }
}
